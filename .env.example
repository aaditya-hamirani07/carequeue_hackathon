# CareQueue Assist Configuration
PORT=8000
HOST=127.0.0.1

# AI Engine Mode: 'local' (default, offline, zero API keys required) or 'external'
CAREQUEUE_AI_MODE=local

# Optional External API Keys (Only queried if CAREQUEUE_AI_MODE=external)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

